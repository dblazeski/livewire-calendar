{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "Private",
    "require": {
        "php": "^8.4",
        "ably/laravel-broadcaster": "^1.0",
        "archtechx/laravel-seo": "^0.10.3",
        "asantibanez/livewire-calendar": "dev-master",
        "cweagans/composer-patches": "^1.7",
        "doctrine/dbal": "^3.7",
        "filament/filament": "^3.3",
        "filament/forms": "^3.3",
        "filament/tables": "^3.3",
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "laravel-notification-channels/fcm": "^6.1",
        "laravel/ai": "^0.4.5",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.33",
        "laravel/nightwatch": "^1.17",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/flysystem-path-prefixing": "^3.28",
        "livewire/livewire": "^3",
        "matanyadaev/laravel-eloquent-spatial": "^4.2",
        "nesbot/carbon": "^3.0",
        "nztim/mailchimp": "^5.3",
        "qodenl/laravel-posthog": "^1.0",
        "rappasoft/laravel-authentication-log": "^6.1.1",
        "ryangjchandler/laravel-cloudflare-turnstile": "^3.0",
        "sentry/sentry-laravel": "^4",
        "spatie/geocoder": "^4.0",
        "spatie/invade": "^2",
        "spatie/laravel-activitylog": "^4.1",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-fractal": "^6.0",
        "spatie/laravel-http-logger": "^1.10",
        "spatie/laravel-markdown-response": "^1.2",
        "spatie/laravel-medialibrary": "^11.21",
        "spatie/laravel-ray": "^1.36",
        "spatie/laravel-sitemap": "^7.2",
        "spatie/schema-org": "^3.23",
        "spatie/url": "^2.0",
        "stevebauman/location": "*",
        "stripe/stripe-php": "^11.0",
        "symfony/http-client": "^7.0",
        "symfony/mailgun-mailer": "^7.0",
        "symfony/postmark-mailer": "^7.0",
        "therobfonz/laravel-mandrill-driver": "^6.1",
        "torann/geoip": "^3.0.10",
        "webfox/laravel-xero-oauth2": "dev-master#bddc848d0c9e2fe079c91bbe415a5c7b7f7fbf17",
        "wire-elements/modal": "^2.0",
        "xeroapi/xero-php-oauth2": "^11.0",
        "zencoreitservices/laravel-editor-js": "^1.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3",
        "defstudio/pest-plugin-laravel-expectations": "^2.1",
        "fakerphp/faker": "^1.9.1",
        "friendsofphp/php-cs-fixer": "^v3.9",
        "fruitcake/laravel-debugbar": "^4.4.2",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.4",
        "laravel/breeze": "^2.3",
        "laravel/pao": "^1.0",
        "laravel/sail": "^1.56",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-browser": "*",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-livewire": "^4.1",
        "phpunit/phpunit": "^12.5",
        "roave/security-advisories": "dev-latest",
        "spatie/laravel-ignition": "^2.0",
        "spatie/pest-plugin-test-time": "^2.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/dblazeski/livewire-calendar"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laravel-shift/livewire-flash.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "vendor/bin/php-cs-fixer fix --allow-risky=yes --using-cache=no",
        "analyze": "./vendor/bin/phpstan analyse --memory-limit=2G",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --force --tag=livewire:assets --ansi",
            "@php artisan clear-compiled",
            "@php artisan optimize:clear",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "ide-helper": [
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "patches": {
            "therobfonz/laravel-mandrill-driver": {
                "Backport PR #45 - throw transport exception on Mandrill API request errors": "patches/laravel-mandrill-driver-pr45.patch"
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "ignore": [
                "PKSA-y2cr-5h3j-g3ys"
            ]
        },
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
